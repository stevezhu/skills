{
  "name": "@stzhu/skills",
  "version": "0.5.0",
  "description": "Skills CLI",
  "keywords": [
    "skills"
  ],
  "license": "MIT",
  "author": "Steve Zhu <4130171+stevezhu@users.noreply.github.com>",
  "repository": "github:stevezhu/skills",
  "bin": {
    "stz-skills": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm run format:check && oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "prepublishOnly": "pnpm run build",
    "pretest": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@stricli/auto-complete": "^1.3.0",
    "@stricli/core": "^1.3.0",
    "find-workspaces": "^0.3.1",
    "gray-matter": "^4.0.3",
    "typebox": "^1.4.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@stzhu/tsconfig": "^0.5.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "pnpm@12.18.0"
}
